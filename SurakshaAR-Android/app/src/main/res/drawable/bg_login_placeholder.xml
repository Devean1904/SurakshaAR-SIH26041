<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0A0F14" />
        </shape>
    </item>
    <!-- Cyan glow top-left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="400"
                android:centerX="0.2"
                android:centerY="0.3"
                android:startColor="#3300E5FF"
                android:endColor="#0000E5FF" />
        </shape>
    </item>
    <!-- Orange glow bottom-right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="350"
                android:centerX="0.85"
                android:centerY="0.85"
                android:startColor="#44FF8C00"
                android:endColor="#00FF8C00" />
        </shape>
    </item>
    <!-- Grid lines effect -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0A00E5FF"
                android:endColor="#050A0F14"
                android:angle="135" />
        </shape>
    </item>
</layer-list>
