<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/loginBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_login_placeholder"
        android:importantForAccessibility="no" />

    <!-- Blur/Dark Overlay -->
    <View
        android:id="@+id/blurOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#600A0F14" />

    <!-- Cyan Glow Overlay (subtle) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1000E5FF" />

    <!-- Main Content - single frame, no scroll -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Login Card Container (Glass Effect) -->
        <LinearLayout
            android:id="@+id/loginCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp"
            android:elevation="8dp">

            <!-- Logo Area -->
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginBottom="8dp"
                android:src="@drawable/ic_launcher_foreground"
                android:importantForAccessibility="no"
                app:tint="#FFD700" />

            <!-- SurakshaAR Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SurakshaAR"
                android:textColor="#FFD700"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="none" />

            <!-- Welcome Text -->
            <TextView
                android:id="@+id/loginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Welcome"
                android:textColor="#CCFFFFFF"
                android:textSize="16sp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/loginSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="AR SAFETY TRAINING"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.15" />

            <!-- Language Button -->
            <TextView
                android:id="@+id/languageButton"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_outline"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="English"
                android:textColor="#FF00E5FF"
                android:textSize="11sp"
                android:importantForAccessibility="yes"
                android:contentDescription="Select language" />

            <!-- User ID Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUserId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Employee ID / Phone"
                app:boxBackgroundColor="@color/et_box_bg"
                app:boxBackgroundMode="filled"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/et_stroke"
                app:boxStrokeWidth="1dp"
                app:hintTextColor="@color/et_hint"
                app:startIconDrawable="@drawable/ic_person"
                app:startIconTint="#80FFFFFF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/userIdInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1"
                    android:nextFocusForward="@id/passwordInput"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#60FFFFFF"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Password / PIN"
                app:boxBackgroundColor="@color/et_box_bg"
                app:boxBackgroundMode="filled"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/et_stroke"
                app:boxStrokeWidth="1dp"
                app:endIconMode="password_toggle"
                app:endIconTint="#80FFFFFF"
                app:hintTextColor="@color/et_hint"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="#80FFFFFF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#60FFFFFF"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Remember Me + Forgot PIN Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/rememberToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remember Me"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp"
                    app:thumbTint="#00E5FF"
                    app:trackTint="#40FFFFFF" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/forgotPinText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forgot PIN?"
                    android:textColor="#9900E5FF"
                    android:textSize="12sp"
                    android:importantForAccessibility="yes"
                    android:contentDescription="Forgot PIN" />
            </LinearLayout>

            <!-- Login Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_primary_selector"
                android:text="LOGIN"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:elevation="4dp"
                app:cornerRadius="12dp"
                app:rippleColor="#4000E5FF" />

            <!-- Status Text -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="#FF4444"
                android:textSize="12sp" />

            <!-- OR Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#30FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:text="OR"
                    android:textColor="#60FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.1" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#30FFFFFF" />
            </LinearLayout>

            <!-- OTP Login Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/otpLoginButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_outline"
                android:text="Login with OTP"
                android:textColor="#FF00E5FF"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_shield"
                app:iconTint="#FF00E5FF"
                app:iconGravity="textStart"
                app:rippleColor="#2000E5FF" />

        </LinearLayout>

        <!-- Footer Version Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="SurakshaAR v1.0"
            android:textColor="#40FFFFFF"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- OTP Panel (hidden by default) -->
    <LinearLayout
        android:id="@+id/otpPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60A0F14"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:background="@drawable/bg_glass_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="36dp"
            android:paddingBottom="32dp"
            android:elevation="8dp">

            <!-- OTP Logo -->
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_shield"
                android:importantForAccessibility="no"
                app:tint="#FF00E5FF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="OTP Verification"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Enter your registered phone number"
                android:textColor="#80FFFFFF"
                android:textSize="13sp" />

            <!-- Phone Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:hint="Phone Number"
                app:boxBackgroundColor="@color/et_box_bg"
                app:boxBackgroundMode="filled"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/et_stroke"
                app:boxStrokeWidth="1dp"
                app:hintTextColor="@color/et_hint"
                app:startIconDrawable="@drawable/ic_phone"
                app:startIconTint="#80FFFFFF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/phoneInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#60FFFFFF"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendOtpButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_primary_selector"
                android:text="SEND OTP"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                app:cornerRadius="12dp" />

            <!-- OTP Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilOtp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Enter OTP"
                app:boxBackgroundColor="@color/et_box_bg"
                app:boxBackgroundMode="filled"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/et_stroke"
                app:boxStrokeWidth="1dp"
                app:hintTextColor="@color/et_hint"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="#80FFFFFF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/otpInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberPassword"
                    android:letterSpacing="0.3"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#60FFFFFF"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/verifyOtpButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_primary_selector"
                android:text="VERIFY OTP"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backToLoginButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@android:color/transparent"
                android:text="← Back to Login"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                app:rippleColor="#20FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Language Panel (hidden by default) -->
    <LinearLayout
        android:id="@+id/languagePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60A0F14"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp"
            android:elevation="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Select Language"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/langEnglish"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_button_outline"
                android:text="English"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/langHindi"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_button_outline"
                android:text="हिन्दी"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/langSantali"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_button_outline"
                android:text="ᱥᱟᱱᱛᱟᱞᱤ"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/langMarathi"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_button_outline"
                android:text="मराठी"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/langTamil"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_button_outline"
                android:text="தமிழ்"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/langTelugu"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_button_outline"
                android:text="తెలుగు"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/langKannada"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_outline"
                android:text="ಕನ್ನಡ"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>